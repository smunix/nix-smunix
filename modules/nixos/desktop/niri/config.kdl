// Niri configuration for the smunix Noctalia desktop session.

spawn-at-startup "noctalia"

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_DESKTOP "niri"
    NIXOS_OZONE_WL "1"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "qt6ct"
    SDL_VIDEODRIVER "wayland"
    GDK_BACKEND "wayland"
    TERMINAL "ghostty"
}

input {
    keyboard {
        xkb {
            layout "us"
        }
    }

    touchpad {
        tap
        dwt
        natural-scroll
    }
}

layout {
    gaps 8
    center-focused-column "on-overflow"
    always-center-single-column

    // Resolution-independent widths suited to a widescreen display.
    preset-column-widths {
        proportion 0.333333
        proportion 0.5
        proportion 0.666667
        proportion 1.0
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
    }
}

// Persistent workspace order.
workspace "shell"
workspace "internet"
workspace "viewers"
workspace "programming"
workspace "explorers"
workspace "chats"
workspace "dumpster"

window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Unmatched applications fill the usable area and default to the dumpster.
// Later application-specific rules override both destination and column width.
window-rule {
    exclude app-id=r#"(?i)^dev\.noctalia\.Noctalia$"#
    open-maximized true
    default-column-width { proportion 1.0; }
    open-on-workspace "dumpster"
}

// Keep Noctalia's settings surface as a centered floating window.
window-rule {
    match app-id=r#"(?i)^dev\.noctalia\.Noctalia$"#
    open-maximized false
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Widescreen auto-tiling: routed applications override the full-width fallback.
window-rule {
    match app-id=r#"(?i)^(org\.wezfurlong\.wezterm|wezterm|com\.mitchellh\.ghostty|ghostty|xterm)$"#
    open-maximized false
    default-column-width { proportion 0.5; }
    open-on-workspace "shell"
}

window-rule {
    match app-id=r#"(?i)^(firefox|org\.mozilla\.firefox|brave-browser|com\.brave\.browser)$"#
    open-maximized false
    default-column-width { proportion 0.666667; }
    open-on-workspace "internet"
}

window-rule {
    match app-id=r#"(?i)^(org\.kde\.okular|okular|org\.gnome\.evince|evince|org\.pwmt\.zathura|zathura|io\.mpv\.Mpv|mpv|xpdf)$"#
    open-maximized false
    default-column-width { proportion 0.5; }
    open-on-workspace "viewers"
}

window-rule {
    match app-id=r#"(?i)^(dev\.zed\.Zed|zed|zeditor)$"#
    open-maximized false
    default-column-width { proportion 0.666667; }
    open-on-workspace "programming"
}

window-rule {
    match app-id=r#"(?i)^(org\.kde\.dolphin|dolphin)$"#
    open-maximized false
    default-column-width { proportion 0.333333; }
    open-on-workspace "explorers"
}

window-rule {
    match app-id=r#"(?i)^(discord|signal|signal-desktop)$"#
    open-maximized false
    default-column-width { proportion 0.5; }
    open-on-workspace "chats"
}

layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

debug {
    honor-xdg-activation-with-invalid-serial
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Applications and Noctalia surfaces.
    Mod+Return { spawn "ghostty"; }
    Mod+D { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    XF86Search { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Shift+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+C { spawn "noctalia" "msg" "panel-toggle" "launcher" "/calc"; }
    Mod+S { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+E { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Shift+W { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Shift+Comma { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Shift+D { spawn "noctalia" "msg" "desktop-widgets-toggle-edit"; }
    Alt+Tab { spawn "noctalia" "msg" "window-switcher"; }
    Ctrl+Alt+L { spawn "noctalia" "msg" "session" "lock"; }
    Super+Alt+L { spawn "noctalia" "msg" "session" "lock"; }

    // Noctalia OSD and hardware controls.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86AudioPlay allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioStop allow-when-locked=true { spawn "noctalia" "msg" "media" "stop"; }
    XF86AudioPrev allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }

    // Window and column navigation.
    Mod+Left { focus-column-left; }
    Mod+Down { focus-window-down; }
    Mod+Up { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Ctrl+Left { move-column-left; }
    Mod+Ctrl+Down { move-window-down; }
    Mod+Ctrl+Up { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H { move-column-left; }
    Mod+Ctrl+J { move-window-down; }
    Mod+Ctrl+K { move-window-up; }
    Mod+Ctrl+L { move-column-right; }

    Mod+Shift+Left { focus-monitor-left; }
    Mod+Shift+Down { focus-monitor-down; }
    Mod+Shift+Up { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H { focus-monitor-left; }
    Mod+Shift+J { focus-monitor-down; }
    Mod+Shift+K { focus-monitor-up; }
    Mod+Shift+L { focus-monitor-right; }

    Mod+Ctrl+Shift+Left { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Down { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+Up { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+J { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+K { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    // Workspaces.
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up { move-column-to-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up { move-workspace-up; }
    Mod+Shift+U { move-workspace-down; }
    Mod+Shift+I { move-workspace-up; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+1 { focus-workspace "shell"; }
    Mod+2 { focus-workspace "internet"; }
    Mod+3 { focus-workspace "viewers"; }
    Mod+4 { focus-workspace "programming"; }
    Mod+5 { focus-workspace "explorers"; }
    Mod+6 { focus-workspace "chats"; }
    Mod+7 { focus-workspace "dumpster"; }
    Mod+Ctrl+1 { move-column-to-workspace "shell"; }
    Mod+Ctrl+2 { move-column-to-workspace "internet"; }
    Mod+Ctrl+3 { move-column-to-workspace "viewers"; }
    Mod+Ctrl+4 { move-column-to-workspace "programming"; }
    Mod+Ctrl+5 { move-column-to-workspace "explorers"; }
    Mod+Ctrl+6 { move-column-to-workspace "chats"; }
    Mod+Ctrl+7 { move-column-to-workspace "dumpster"; }

    // Layout controls.
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+R { switch-preset-column-width; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    Mod+Ctrl+F { expand-column-to-available-width; }
    Mod+Ctrl+C { center-visible-columns; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Screenshots and session controls.
    Print { spawn "noctalia" "msg" "screenshot-region"; }
    Ctrl+Print { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Alt+Print { screenshot-window; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Q repeat=false { close-window; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { spawn "noctalia" "msg" "panel-toggle" "session"; }
}
